# /etc/systemd/system/instantclip.service
[Unit]
Description=instantclip (DeckLink capture + web subclip editor)
Wants=network-online.target
After=network-online.target mediamtx.service

[Service]
Type=simple
User=sendust
Group=sendust
WorkingDirectory=/home/sendust/instantclip
ExecStart=/home/sendust/instantclip/.venv/bin/python -m app.main
Environment=PYTHONUNBUFFERED=1
# Environment=INSTANTCLIP_CONFIG=/home/sendust/instantclip/config.json

# SIGTERM goes to the backend only; it stops every ffmpeg itself (SIGINT -> SIGTERM -> SIGKILL),
# so recordings are finalized (HLS ENDLIST) on service stop.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
